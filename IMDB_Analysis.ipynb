import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# 1. LOAD DATA
movies = pd.read_csv('Movie+Assignment+Data.csv')

# 2. DATA CLEANING & NEW METRICS
# Calculating Profit in Millions
movies['Profit'] = (movies['Gross'] - movies['budget']) / 1_000_000 
# ROI (Return on Investment) - adds complexity to your analysis
movies['ROI'] = (movies['Profit'] * 1_000_000 / movies['budget']) * 100

# 3. ANALYSIS: TOP 10 PROFITABLE MOVIES
top10 = movies.sort_values(by='Profit', ascending=False).head(10)

plt.figure(figsize=(12, 6))
sns.barplot(data=top10, x='Profit', y='Title', palette='magma')
plt.title('Top 10 Most Profitable Movies ($ Millions)')
plt.xlabel('Profit (Millions)')
plt.show()

# 4. ANALYSIS: GENRE PERFORMANCE
genre_perf = movies.groupby('genre_1')[['Profit', 'IMDb_rating']].mean().sort_values(by='Profit', ascending=False)
print("Average Profit and Rating by Genre:\n", genre_perf)

# 5. ANALYSIS: DEMOGRAPHIC VOTING (Team Creativity)
# We compare how Men vs Women rated the movies
plt.figure(figsize=(10, 6))
sns.scatterplot(data=movies, x='VotesM', y='VotesF', hue='genre_1')
plt.plot([7, 9], [7, 9], 'r--') # Reference line for equal rating
plt.title('Male vs Female IMDb Ratings')
plt.show()
